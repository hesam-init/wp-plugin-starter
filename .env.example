# ------------------------------------------------------------------
# Project identity (rewritten by `make init`)
# ------------------------------------------------------------------
PLUGIN_SLUG=wp-plugin-starter
COMPOSE_PROJECT_NAME=wp-plugin-starter

# ------------------------------------------------------------------
# Registries & mirrors (leave empty for the public defaults)
# Baked into the local images (docker/node, docker/php, docker/tools) and
# used by `make zip`. The next `make` command rebuilds the images by itself
# when one of these changes (`make rebuild` forces it).
# ------------------------------------------------------------------
# Registry host (and optional path) for every Docker image, WITHOUT a trailing slash.
#   docker.io (default)          → DOCKER_REGISTRY=
#   a pull-through mirror        → DOCKER_REGISTRY=docker.arvancloud.ir
#   a private registry/project   → DOCKER_REGISTRY=registry.example.com/library
# (Alternative: set "registry-mirrors" in your Docker daemon config.)
DOCKER_REGISTRY=docker.arvancloud.ir
# npm registry, e.g. https://registry.npmmirror.com/ (default: https://registry.npmjs.org/)
NPM_REGISTRY=https://mirror-npm.pkg.shecan.ir/
# Composer (Packagist) repository, e.g. https://packagist.example.com (default: https://repo.packagist.org)
COMPOSER_REGISTRY=https://mirror-composer.pkg.shecan.ir
# Debian apt mirror (must also serve /debian-security), e.g. https://mirror.example.com (default: http://deb.debian.org)
APT_MIRROR=https://repo.abrha.net
# WP-CLI release baked into the php image. WP_CLI_URL overrides the download
# URL (default: the GitHub release of WP_CLI_VERSION), e.g. to use a mirror.
WP_CLI_VERSION=2.12.0
WP_CLI_URL=

# ------------------------------------------------------------------
# Local WordPress
# ------------------------------------------------------------------
# wordpress:<tag>; the php*-apache tags are Debian trixie based
WP_IMAGE_TAG=php8.3-apache
WP_PORT=8080
WP_URL=http://localhost:8080
WP_TITLE=Plugin Dev
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=admin
WP_ADMIN_EMAIL=admin@example.com
# Core language packs installed by `make setup` (space separated)
WP_LANGUAGES=fa_IR

# ------------------------------------------------------------------
# Database
# ------------------------------------------------------------------
DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=wordpress
DB_ROOT_PASSWORD=root

# ------------------------------------------------------------------
# Vite dev server (URL as seen by *your browser*, not the container)
# ------------------------------------------------------------------
VITE_PORT=5173
VITE_DEV_SERVER_URL=http://localhost:5173
# Set to true on macOS/Windows if HMR misses file changes
VITE_USE_POLLING=false

# ------------------------------------------------------------------
# Toolchain versions (all images are Debian trixie)
# ------------------------------------------------------------------
# node:<NODE_VERSION>-trixie-slim
NODE_VERSION=24
# php:<PHP_VERSION>-cli-trixie (Composer, WP-CLI); keep it equal to WP_IMAGE_TAG's PHP
PHP_VERSION=8.3
