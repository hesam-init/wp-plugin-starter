# ------------------------------------------------------------------
# Project identity (rewritten by `make init`)
# ------------------------------------------------------------------
PLUGIN_SLUG=wp-plugin-starter
COMPOSE_PROJECT_NAME=wp-plugin-starter

# ------------------------------------------------------------------
# Local WordPress
# ------------------------------------------------------------------
WP_IMAGE_TAG=php8.3-apache
WP_PORT=8080
WP_URL=http://localhost:8080
WP_TITLE=Plugin Dev
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=admin
WP_ADMIN_EMAIL=admin@example.com
# Core language packs installed by `make setup` (space separated)
WP_LANGUAGES=fa_IR

# ------------------------------------------------------------------
# Database
# ------------------------------------------------------------------
DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=wordpress
DB_ROOT_PASSWORD=root

# ------------------------------------------------------------------
# Vite dev server (URL as seen by *your browser*, not the container)
# ------------------------------------------------------------------
VITE_PORT=5173
VITE_DEV_SERVER_URL=http://localhost:5173
# Set to true on macOS/Windows if HMR misses file changes
VITE_USE_POLLING=false

# ------------------------------------------------------------------
# Toolchain versions
# ------------------------------------------------------------------
NODE_VERSION=24
PHP_VERSION=8.3
